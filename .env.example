# ───────── GitHub (프로젝트 탭에서 org repo 읽기) ─────────
# classic PAT(scope: repo, read:org) 권장. org 기본권한이 read라 멤버 토큰이면
# 새 repo도 자동으로 다 보임. fine-grained PAT를 "특정 repo만"으로 쓰면
# 발급 이후 만든 repo가 누락되니 그땐 "All repositories"로.
GITHUB_TOKEN=ghp_로_시작하는_classic_PAT
GITHUB_OWNER=qnbang

# 구글 시트(Apps Script 웹앱) 주소와 비밀번호
SHEET_URL=https://script.google.com/macros/s/XXXX/exec
SHEET_KEY=시트_비밀번호

# 대시보드 접속 비밀번호 (직원에게 공유할 값)
DASHBOARD_PASSWORD=원하는_접속_비밀번호

# 로그인 쿠키에 쓰는 비밀 토큰 (아무 긴 무작위 문자열)
AUTH_TOKEN=길고_무작위한_문자열

# ───────── 팝빌 전자세금계산서 ─────────
# 팝빌에서 발급받은 연동 인증키
POPBILL_LINK_ID=발급받은_LinkID
POPBILL_SECRET_KEY=발급받은_SecretKey
# 테스트 모드 여부 (true=테스트, false=실제 국세청 전송)
POPBILL_IS_TEST=true

# 공급자(우리 회사 = 큐앤뱅) 정보
POPBILL_CORP_NUM=사업자번호숫자10자리   # '-' 없이 숫자만
POPBILL_CORP_NAME=큐앤뱅
POPBILL_CEO_NAME=대표자명
POPBILL_ADDR=사업장주소
POPBILL_BIZ_TYPE=업태
POPBILL_BIZ_CLASS=종목
POPBILL_CONTACT_NAME=담당자명
POPBILL_TEL=연락처
POPBILL_EMAIL=담당자이메일

# 화면 상단 배지를 운영 모드로 표시하려면 false (선택)
NEXT_PUBLIC_POPBILL_TEST=true
